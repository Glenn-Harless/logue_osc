{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Logue Oscillator Manifest",
  "type": "object",
  "required": ["id", "name", "description", "source", "parameters"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "source": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "defaultLevel": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Optional default level percentage (0-100) for the user oscillator mix"
    },
    "wasm": {
      "type": "object",
      "properties": {
        "module": { "type": "string" }
      },
      "required": ["module"],
      "additionalProperties": false
    },
    "fallback": {
      "type": "object",
      "properties": {
        "module": { "type": "string" },
        "export": { "type": "string" }
      },
      "required": ["module"],
      "additionalProperties": false
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "name", "description", "min", "max"],
        "properties": {
          "index": { "type": "integer", "minimum": 0, "maximum": 255 },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "unit": { "type": "string" },
          "group": { "type": "string" },
          "min": { "type": "integer", "minimum": 0, "maximum": 1023 },
          "max": { "type": "integer", "minimum": 0, "maximum": 1023 },
          "default": { "type": "integer", "minimum": 0, "maximum": 1023 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
